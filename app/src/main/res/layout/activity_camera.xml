<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0b0b0e"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="📸 Food Photo"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="#f5b041"
            android:gravity="center"
            android:layout_marginTop="8dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Take a photo of your food"
            android:textColor="#888"
            android:gravity="center"
            android:layout_marginBottom="16dp" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="250dp"
            android:background="#1a1a1f"
            android:layout_marginBottom="8dp">

            <ImageView
                android:id="@+id/photoPreview"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:src="@android:drawable/ic_menu_camera" />

            <TextView
                android:id="@+id/resultText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom"
                android:background="#88000000"
                android:text="Take a photo to identify food"
                android:textColor="#fff"
                android:textSize="16sp"
                android:gravity="center"
                android:padding="12dp" />
        </FrameLayout>

        <!-- MANUAL ENTRY: always visible -->
        <LinearLayout
            android:id="@+id/manualEntryRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="8dp"
            android:visibility="visible">

            <EditText
                android:id="@+id/foodNameInput"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:hint="Type the food name..."
                android:textColor="#fff"
                android:textSize="10sp"
                android:textColorHint="#666"
                android:background="#121216"
                android:padding="12dp"
                android:inputType="text"
                android:layout_marginEnd="4dp" />

            <Button
                android:id="@+id/confirmFoodBtn"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:text="✅ Use"
                android:textSize="10sp"
                android:background="@drawable/rounded_button_green"
                android:textColor="#fff"
                android:minHeight="0dp"
                android:includeFontPadding="false"
                android:singleLine="true"
                android:gravity="center"
                android:paddingStart="12dp"
                android:paddingEnd="12dp" />
        </LinearLayout>

        <WebView
            android:id="@+id/webView"
            android:layout_width="match_parent"
            android:layout_height="280dp"
            android:visibility="gone"
            android:layout_marginBottom="8dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/captureBtn"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:minHeight="0dp"
            android:minWidth="0dp"
            android:text="📷 Take Photo"
            android:textColor="#ffffff"
            android:textSize="13sp"
            android:singleLine="true"
            android:gravity="center"
            android:padding="0dp"
            android:includeFontPadding="false"
            app:cornerRadius="12dp"
            app:backgroundTint="#4CAF50" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/galleryBtn"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:minHeight="0dp"
            android:minWidth="0dp"
            android:text="🖼️ Choose from Gallery"
            android:background="@drawable/rounded_button_green"
            android:textColor="#ffffff"
            android:textSize="13sp"
            android:padding="0dp"
            android:includeFontPadding="false"
            android:singleLine="true"
            android:gravity="center"
            android:layout_marginTop="8dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="8dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/searchAiBtn"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:minHeight="0dp"
                android:minWidth="0dp"
                android:text="🧠 AI"
                android:background="@drawable/rounded_button_green"
                android:textColor="#ffffff"
                android:textSize="12sp"
                android:padding="0dp"
                android:includeFontPadding="false"
                android:singleLine="true"
                android:gravity="center"
                android:visibility="gone" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/searchGoogleBtn"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:minHeight="0dp"
                android:minWidth="0dp"
                android:text="🔎 Google"
                android:background="@drawable/rounded_button_green"
                android:textColor="#ffffff"
                android:textSize="12sp"
                android:padding="0dp"
                android:includeFontPadding="false"
                android:singleLine="true"
                android:gravity="center"
                android:layout_marginStart="8dp"
                android:visibility="gone" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/searchBingBtn"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:minHeight="0dp"
                android:minWidth="0dp"
                android:text="🔎 Bing"
                android:background="@drawable/rounded_button_green"
                android:textColor="#ffffff"
                android:textSize="12sp"
                android:padding="0dp"
                android:includeFontPadding="false"
                android:singleLine="true"
                android:gravity="center"
                android:layout_marginStart="8dp"
                android:visibility="gone" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/searchYandexBtn"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:minHeight="0dp"
                android:minWidth="0dp"
                android:text="🔎 Yandex"
                android:background="@drawable/rounded_button_green"
                android:textColor="#ffffff"
                android:textSize="12sp"
                android:padding="0dp"
                android:includeFontPadding="false"
                android:singleLine="true"
                android:gravity="center"
                android:layout_marginStart="8dp"
                android:visibility="gone" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/useFoodBtn"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:minHeight="0dp"
            android:minWidth="0dp"
            android:text="📝 Use This Food"
            android:background="@drawable/rounded_button_green"
            android:textColor="#ffffff"
            android:textSize="13sp"
            android:padding="0dp"
            android:includeFontPadding="false"
            android:singleLine="true"
            android:gravity="center"
            android:layout_marginTop="8dp"
            android:visibility="gone" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/fixBtn"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:minHeight="0dp"
            android:minWidth="0dp"
            android:text="✏️ Fix: This is actually..."
            android:background="@drawable/rounded_button_green"
            android:textColor="#ffffff"
            android:textSize="13sp"
            android:padding="0dp"
            android:includeFontPadding="false"
            android:singleLine="true"
            android:gravity="center"
            android:layout_marginTop="8dp"
            android:visibility="gone" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/backBtn"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:minHeight="0dp"
            android:minWidth="0dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/rounded_button_green"
            android:padding="0dp"
            android:includeFontPadding="false"
            android:text="← Back"
            android:textColor="#ffffff"
            android:textSize="13sp"
            android:singleLine="true"
            android:gravity="center" />

    </LinearLayout>
</ScrollView>