<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#0b0b0e"
    android:padding="16dp"
    android:gravity="center">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="📱 Barcode Scanner"
        android:textSize="28sp"
        android:textStyle="bold"
        android:textColor="#f5b041"
        android:gravity="center"
        android:layout_marginTop="8dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Scan packaged foods"
        android:textColor="#888"
        android:gravity="center"
        android:layout_marginBottom="16dp" />

    <TextView
        android:id="@+id/resultText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Take a photo of a barcode"
        android:textColor="#ccc"
        android:textSize="16sp"
        android:gravity="center"
        android:padding="16dp"
        android:background="#1a1a1f"
        android:layout_marginBottom="16dp"
        android:minHeight="150dp" />

    <Button
        android:id="@+id/useBtn"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="📝 Use This Food"
        android:background="#4CAF50"
        android:textColor="#fff"
        android:padding="14dp"
        android:textSize="16sp"
        android:layout_marginBottom="8dp"
        android:visibility="gone" />

    <Button
        android:id="@+id/scanBtn"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="📷 Take Photo"
        android:background="#4FC3F7"
        android:textColor="#fff"
        android:padding="14dp"
        android:textSize="16sp" />

    <Button
        android:id="@+id/galleryBtn"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="🖼️ Choose from Gallery"
        android:background="#f5b041"
        android:textColor="#fff"
        android:padding="14dp"
        android:textSize="16sp"
        android:layout_marginTop="6dp" />

    <Button
        android:id="@+id/backBtn"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="← Back"
        android:background="#2a2a32"
        android:textColor="#fff"
        android:padding="14dp"
        android:layout_marginTop="12dp" />

</LinearLayout>