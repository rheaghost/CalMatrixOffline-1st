                android:background="@drawable/rounded_button_nav"
                android:textColor="#7ddf7d"
                android:padding="0dp"
                android:minHeight="0dp"
                android:minWidth="0dp"
                android:includeFontPadding="false"
                android:singleLine="true"
                android:gravity="center"
