<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#0b0b0e"
    android:padding="16dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="⚙️ Settings"
        android:textSize="28sp"
        android:textStyle="bold"
        android:textColor="#f5b041"
        android:gravity="center"
        android:layout_marginTop="8dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Google Search API Key"
        android:textColor="#7ddf7d"
        android:textSize="16sp"
        android:layout_marginTop="24dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Get your free key from https://api.imgbb.com/"
        android:textColor="#888"
        android:textSize="12sp"
        android:layout_marginTop="4dp" />

    <EditText
        android:id="@+id/apiKeyInput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Paste your imgbb API key here"
        android:textColor="#fff"
        android:textColorHint="#666"
        android:background="#121216"
        android:padding="14dp"
        android:layout_marginTop="8dp" />

    <Button
        android:id="@+id/saveBtn"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="💾 Save API Key"
        android:background="@drawable/rounded_button_green"

        android:textColor="#fff"
        android:padding="14dp"
        android:layout_marginTop="16dp" />

    <Button
        android:id="@+id/backBtn"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="← Back"
        android:background="@drawable/rounded_button1"
        android:textColor="#fff"
        android:padding="14dp"
        android:layout_marginTop="8dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Daily Reminder Time"
        android:textColor="#7ddf7d"
        android:textSize="16sp"
        android:layout_marginTop="24dp" />

    <EditText
        android:id="@+id/reminderHourInput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Minutes from now (for testing)"
        android:textColor="#fff"
        android:textColorHint="#666"
        android:background="#121216"
        android:padding="14dp"
        android:inputType="number"
        android:layout_marginTop="4dp" />

    <Button
        android:id="@+id/saveReminderBtn"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="💾 Save Reminder"
        android:background="#4CAF50"
        android:textColor="#fff"
        android:padding="14dp"
        android:layout_marginTop="8dp" />

</LinearLayout>