<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#0b0b0e"
    android:padding="16dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="📊 Trends"
        android:textSize="28sp"
        android:textStyle="bold"
        android:textColor="#f5b041"
        android:gravity="center"
        android:layout_marginTop="8dp" />

    <TextView
        android:id="@+id/budgetText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="🎯 Daily Budget: -- cal/day"
        android:textColor="#888"
        android:gravity="center"
        android:textSize="16sp"
        android:layout_marginTop="4dp" />

    <TextView
        android:id="@+id/summaryText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Loading..."
        android:textColor="#ccc"
        android:gravity="center"
        android:layout_marginTop="8dp"
        android:textSize="16sp" />



    <!-- Scrollable Chart -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="350dp"
        android:layout_marginTop="12dp"
        android:scrollbars="horizontal">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:orientation="horizontal">

            <com.calmatrixoffline.SimpleChartView
                android:id="@+id/chartView"
                android:layout_width="800dp"
                android:layout_height="match_parent" />

        </LinearLayout>
    </HorizontalScrollView>
2
    <!-- Legend -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginTop="12dp">

        <View
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:background="#4CAF50"
            android:layout_marginEnd="8dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Surplus"
            android:textColor="#ccc"
            android:textSize="14sp"
            android:layout_marginEnd="24dp" />

        <View
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:background="#F44336"
            android:layout_marginEnd="8dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Deficit"
            android:textColor="#ccc"
            android:textSize="14sp" />

    </LinearLayout>

    <Button
        android:id="@+id/backBtn"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="← Back"

        android:textColor="#fff"
        android:background="@drawable/rounded_button1"
        android:layout_marginTop="16dp"
        android:padding="12dp" />

</LinearLayout>